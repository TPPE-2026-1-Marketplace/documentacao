#!/usr/bin/env sh
#
# Preenche os trailers Co-authored-by automaticamente.
#
# Quando o commit é autorado por BrunoBReis, DiceRunner714 ou DeM4rcio, os
# outros dois entram como co-autores da mensagem.
#
# Instalação (uma vez por clone):
#   make hooks     # equivale a: git config core.hooksPath .githooks
#
set -eu

MSG_FILE="$1"

BRUNO='Co-authored-by: Bruno Braganca <brunobragancadosreis@gmail.com>'
EDUARDO='Co-authored-by: Eduardo Sandes <eduardo.sandes6@gmail.com>'
MARCIO='Co-authored-by: Márcio Henrique <henriquemarcio170@gmail.com>'

# Identidade de quem assina o commit: respeita user.email do clone, --author e
# GIT_AUTHOR_EMAIL. Em minúsculas para casar tanto o e-mail pessoal quanto o
# endereço @users.noreply.github.com, que carrega o login do GitHub.
ident=$(git var GIT_AUTHOR_IDENT | tr '[:upper:]' '[:lower:]')

case "$ident" in
	*brunobragancadosreis*|*brunobreis*) co1=$EDUARDO; co2=$MARCIO ;;
	*eduardo.sandes6*|*dicerunner714*)   co1=$BRUNO;   co2=$MARCIO ;;
	*henriquemarcio170*|*dem4rcio*)      co1=$BRUNO;   co2=$EDUARDO ;;
	# Commit de quem não é do trio: mensagem segue intacta.
	*) exit 0 ;;
esac

# addIfDifferent não duplica um trailer que já tenha sido escrito à mão.
git interpret-trailers --in-place --if-exists addIfDifferent \
	--trailer "$co1" --trailer "$co2" "$MSG_FILE"
